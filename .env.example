# Copy this file to .env for local development.
# NUXT_PUBLIC_* values are sent to the browser and must never contain secrets.
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NUXT_PUBLIC_MAP3D_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NUXT_PUBLIC_MAP_ATTRIBUTION="Vzorčni nepremičninski podatki © Prostor na dlani"
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only credential. Leave empty until a provider adapter uses it.
NUXT_MAP_PROVIDER_TOKEN=
