# Copy this file to .env for local development.
# NUXT_PUBLIC_* values are sent to the browser and must never contain secrets.
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NUXT_PUBLIC_MAP3D_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NUXT_PUBLIC_MAP_ATTRIBUTION="Podatki GURS © Prostor na dlani"
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Property Scraper API. Both values are server-only and never sent to browsers.
NUXT_GURS_API_BASE_URL=http://localhost:3001
NUXT_GURS_API_KEY=

# Optional server-only map-provider credential.
NUXT_MAP_PROVIDER_TOKEN=
